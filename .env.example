# Copy to .env and adjust. All variables are optional; defaults are shown.

# Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_CHUNK_STRATEGY=recursive

# Embeddings
RAG_EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chat model
RAG_LLM_PROVIDER=anthropic
RAG_LLM_MODEL=claude-3-5-sonnet-latest

# Vector store
RAG_VECTOR_STORE=chroma
RAG_QDRANT_URL=http://localhost:6333

# Observability
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false

# Tracing (LangSmith)
RAG_LANGSMITH_TRACING=false
RAG_LANGSMITH_PROJECT=rag-data-loader
RAG_LANGSMITH_API_KEY=

# Provider API keys (standard names, read by the LangChain provider packages)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
